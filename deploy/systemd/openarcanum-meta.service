# OpenArcanum maintainer node (docs/admin-guide.md "Running the servers with systemd").
#
#   install -m 0755 meta /usr/local/bin/meta
#   install -d -m 0755 /etc/openarcanum && install -m 0644 meta.json /etc/openarcanum/meta.json
#   cp openarcanum-meta.service openarcanum-meta-backup.service openarcanum-meta-backup.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now openarcanum-meta openarcanum-meta-backup.timer
#
# Data (meta.db and the DM blob store) lives in /var/lib/openarcanum-meta; the
# environment variable below overrides data_dir in meta.json.

[Unit]
Description=OpenArcanum maintainer node
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/meta -config /etc/openarcanum/meta.json
Environment=OPENARCANUM_META_DATA_DIR=/var/lib/openarcanum-meta
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536

# The same user name as openarcanum-meta-backup.service, so both own the data.
DynamicUser=yes
User=openarcanum-meta
StateDirectory=openarcanum-meta
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
