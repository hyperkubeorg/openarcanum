# OpenArcanum relay (docs/admin-guide.md "Running the servers with systemd").
#
#   install -m 0755 relay /usr/local/bin/relay
#   install -d -m 0755 /etc/openarcanum && install -m 0644 relay.json /etc/openarcanum/relay.json
#   cp openarcanum-relay.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now openarcanum-relay
#
# The relay keeps nothing on disk except, when it reports to maintainer
# nodes (registry_urls), its registry key in the state directory.

[Unit]
Description=OpenArcanum relay
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/relay -config /etc/openarcanum/relay.json
Environment=OPENARCANUM_RELAY_REGISTRY_KEY_FILE=/var/lib/openarcanum-relay/registry.key
# Used only with tls_mode acme (docs/operations.md "TLS and browsers").
Environment=OPENARCANUM_RELAY_ACME_CACHE_DIR=/var/lib/openarcanum-relay/acme
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
LimitNOFILE=65536

# Its own unprivileged user, created for the service; writable state only in
# /var/lib/openarcanum-relay. Ports above 1024 need no capability. For
# tls_mode acme on :443, add a drop-in with
# AmbientCapabilities=CAP_NET_BIND_SERVICE,
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE and PrivateUsers=no, or
# forward 443 to the listen port.
DynamicUser=yes
StateDirectory=openarcanum-relay
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# Netlink: the call media server (Pion) lists the host's addresses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
