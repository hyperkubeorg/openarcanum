# One maintainer node backup (started by openarcanum-meta-backup.timer). Safe
# while the node runs: `meta backup` reads a consistent snapshot and keeps
# the newest 7 backups in /var/lib/openarcanum-meta/backups. Copy them off the
# machine from there: openarcanum-meta-backup-sync.service does that after
# each backup once it is configured (rsync, restic, … work too).

[Unit]
Description=OpenArcanum maintainer node backup
After=openarcanum-meta.service
Wants=openarcanum-meta-backup-sync.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/meta backup -data /var/lib/openarcanum-meta -out /var/lib/openarcanum-meta/backups -keep 7
Nice=10
IOSchedulingClass=idle

DynamicUser=yes
User=openarcanum-meta
StateDirectory=openarcanum-meta
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed
