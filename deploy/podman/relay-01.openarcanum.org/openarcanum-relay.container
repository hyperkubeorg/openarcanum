# OpenArcanum relay on relay-01.openarcanum.org.
# Quadlet file: /home/openarcanum/.config/containers/systemd/openarcanum-relay.container
# systemd (user openarcanum) generates openarcanum-relay.service from it.

[Unit]
Description=OpenArcanum relay (relay-01.openarcanum.org)

[Container]
# Pin the release. To upgrade or roll back, change the tag (README.md).
Image=ghcr.io/hyperkubeorg/openarcanum-relay:2026.10.0
ContainerName=openarcanum-relay
# podman auto-update pulls this tag again and restarts when its digest changed.
AutoUpdate=registry
Exec=-config /etc/openarcanum/relay.json

# Host network: the relay binds 443/tcp itself (sysctl
# ip_unprivileged_port_start) and the call media port 7000/udp, sees real
# client addresses (per-network limits) and offers the host's own
# addresses to call clients.
Network=host
# The image runs as uid 65532. Map that uid to the host user openarcanum,
# so the bind-mounted directories are simply owned by openarcanum.
UserNS=keep-id:uid=65532,gid=65532
# :Z gives each directory a private SELinux label for this container.
Volume=/home/openarcanum/relay/config:/etc/openarcanum:ro,Z
Volume=/home/openarcanum/relay/keys:/keys:Z
Volume=/home/openarcanum/relay/acme:/acme:Z

# The image sets OPENARCANUM_RELAY_LISTEN=:7000, and the environment wins
# over the config file, so the public port is set here.
Environment=OPENARCANUM_RELAY_LISTEN=:443

ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Ulimit=nofile=65536:65536
LogDriver=journald
# The image's health check asks http://127.0.0.1:7000/healthz: the status
# listener (metrics_listen in relay.json, TCP; media uses UDP 7000).
# Restart the service when it fails.
HealthOnFailure=kill
PodmanArgs=--stop-timeout=15

[Service]
Restart=always
RestartSec=5
# The first start pulls the image.
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
