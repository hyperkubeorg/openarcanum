#!/usr/bin/env python3
"""Build the page's icon table, clients/shared/ui/js/icons.js, from the
vendored Lucide icons in clients/shared/ui/vendor/lucide/icons/.

    scripts/ui-icons            rewrite ui/js/icons.js
    scripts/ui-icons --check    fail if it is stale, a vendored file doesn't
                                match vendor/lucide/SHA256SUMS, or the page
                                uses an icon that isn't vendored

The page draws icons as inline SVG built with DOM calls (icon() in
ui/js/dom.js), so it needs each icon's shapes as data: the elements inside
the <svg> and their attributes, nothing else. The root <svg> attributes are
Lucide's fixed ones (24x24, stroke currentColor, width 2, round caps) and
icon() sets them. To add an icon: copy its file from the lucide-static
release named in vendor/lucide/VENDORED.md into vendor/lucide/icons/
unchanged, add its line to SHA256SUMS, and run this script.

Python standard library only.
"""

from __future__ import annotations

import hashlib
import json
import re
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
UI = ROOT / "clients" / "shared" / "ui"
VENDOR = UI / "vendor" / "lucide"
OUT = UI / "js" / "icons.js"
SVG_NS = "{http://www.w3.org/2000/svg}"
SHAPES = {"path", "circle", "rect", "line", "polyline", "polygon", "ellipse"}
# What may appear on a shape: geometry only (no styles, events or links).
ATTRS = {"d", "cx", "cy", "r", "rx", "ry", "x", "y", "x1", "y1", "x2", "y2", "width", "height", "points"}
# How the page names icons: icon('name'), and h()'s icon attribute, whose
# value may choose between names (`icon: on ? 'bell-off' : 'bell'`).
USES = re.compile(r"""\bicon\(\s*'([a-z0-9-]+)'""")
ATTR_USES = re.compile(r"""\bicon:\s*([^,}]+)""")
NAME = re.compile(r"'([a-z0-9-]+)'")


def shapes(path: Path) -> list[list]:
    root = ET.fromstring(path.read_text(encoding="utf-8"))
    out = []
    for el in root:
        tag = el.tag.removeprefix(SVG_NS)
        if tag not in SHAPES:
            raise SystemExit(f"{path.name}: <{tag}> is not a plain shape")
        extra = set(el.attrib) - ATTRS
        if extra:
            raise SystemExit(f"{path.name}: unexpected attributes {sorted(extra)}")
        out.append([tag, dict(sorted(el.attrib.items()))])
    return out


def version() -> str:
    m = re.search(r"lucide-static v([0-9.]+)", next(iter(sorted((VENDOR / "icons").glob("*.svg")))).read_text())
    return m.group(1) if m else "?"


def generate() -> str:
    lines = [
        f"// Generated by scripts/ui-icons from ui/vendor/lucide (Lucide {version()}, ISC licence:",
        "// ui/vendor/lucide/LICENSE). Do not edit: change the vendored icons and rerun the script.",
        "// Each icon is the list of shapes inside its 24x24 <svg>; icon() in dom.js draws it.",
        "'use strict';",
        "",
        "const ICONS = Object.freeze({",
    ]
    for p in sorted((VENDOR / "icons").glob("*.svg")):
        lines.append(f"  {json.dumps(p.stem)}: {json.dumps(shapes(p), separators=(', ', ': '))},")
    lines += ["});", ""]
    return "\n".join(lines)


def check_sums() -> list[str]:
    problems = []
    listed: dict[str, str] = {}
    for line in (VENDOR / "SHA256SUMS").read_text().splitlines():
        digest, name = line.split(maxsplit=1)
        listed[name.lstrip("*")] = digest
    present = {"LICENSE"} | {f"icons/{p.name}" for p in (VENDOR / "icons").glob("*.svg")}
    for name in sorted(present | set(listed)):
        f = VENDOR / name
        if name not in listed:
            problems.append(f"{name} is not in SHA256SUMS")
        elif not f.exists():
            problems.append(f"{name} is in SHA256SUMS but missing")
        elif hashlib.sha256(f.read_bytes()).hexdigest() != listed[name]:
            problems.append(f"{name} doesn't match SHA256SUMS")
    return problems


def used() -> set[str]:
    names: set[str] = set()
    for p in (UI / "js").glob("*.js"):
        if p != OUT:
            text = p.read_text(encoding="utf-8")
            names |= set(USES.findall(text))
            for value in ATTR_USES.findall(text):
                names |= set(NAME.findall(value))
    return names


def main(argv: list[str]) -> int:
    if argv == ["--check"]:
        problems = check_sums()
        if not OUT.exists() or OUT.read_text(encoding="utf-8") != generate():
            problems.append(f"{OUT.relative_to(ROOT)} is stale: run scripts/ui-icons")
        have = {p.stem for p in (VENDOR / "icons").glob("*.svg")}
        problems += [f"the page uses icon {n!r}, which isn't vendored" for n in sorted(used() - have)]
        problems += [f"vendored icon {n!r} is unused: remove it" for n in sorted(have - used())]
        for p in problems:
            print(p, file=sys.stderr)
        return 1 if problems else 0
    if argv:
        print(__doc__, file=sys.stderr)
        return 2
    OUT.write_text(generate(), encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
